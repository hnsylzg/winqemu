<Window x:Class="WinqEmuLauncher.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:WinqEmuLauncher"
        Title="{loc:Loc DlgTitle}" Height="160" Width="420" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Width" Value="72" />
            <Setter Property="Margin" Value="3" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="4,2" />
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="txtPrompt" Grid.Row="0" Margin="2,2,2,6" TextWrapping="Wrap" />
        <TextBox x:Name="txtInput" Grid.Row="1" Margin="2,0,2,8" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnOk" Content="{loc:Loc BtnOk}" Click="btnOk_Click" IsDefault="True" />
            <Button x:Name="btnCancel" Content="{loc:Loc BtnCancel}" Click="btnCancel_Click" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
